---
// Top 10 albums of the last month from Last.fm, fetched in the browser.
// Set `lastfmUser` in src/site.ts and PUBLIC_LASTFM_API_KEY in .env.
---

<div class="music">
  <ol class="albums" aria-live="polite">
    {Array.from({ length: 10 }, () => <li class="skeleton"></li>)}
  </ol>
  <p class="status" hidden>Couldn't load albums right now.</p>
</div>

<script>
  import { site } from '../../site';

  const list = document.querySelector<HTMLElement>('.music .albums')!;
  const status = document.querySelector<HTMLElement>('.music .status')!;
  const key = import.meta.env.PUBLIC_LASTFM_API_KEY;

  type Album = {
    name: string;
    url: string;
    playcount: string;
    artist: { name: string };
    image: { size: string; '#text': string }[];
  };

  async function load() {
    if (!key || !site.lastfmUser) throw new Error('Last.fm not configured');
    const url =
      'https://ws.audioscrobbler.com/2.0/?method=user.gettopalbums&period=1month&limit=10&format=json' +
      `&user=${encodeURIComponent(site.lastfmUser)}&api_key=${key}`;
    const res = await fetch(url);
    const json = await res.json();
    const albums: Album[] = json.topalbums?.album ?? [];
    if (!albums.length) throw new Error('No albums');

    list.replaceChildren(
      ...albums.map((a) => {
        const cover = a.image.find((i) => i.size === 'extralarge')?.['#text'];
        const li = document.createElement('li');
        li.innerHTML = `
          <a href="${a.url}" target="_blank" rel="noopener">
            <div class="cover">${cover ? `<img src="${cover}" alt="" loading="lazy" />` : ''}</div>
            <p class="name"></p>
            <p class="artist"></p>
          </a>`;
        li.querySelector('.name')!.textContent = a.name;
        li.querySelector('.artist')!.textContent = `${a.artist.name} · ${a.playcount} plays`;
        return li;
      }),
    );
  }

  load().catch((err) => {
    console.warn('[music] Last.fm albums failed to load:', err);
    list.hidden = true;
    status.hidden = false;
  });
</script>

<style>
  .albums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }
  .albums[hidden] { display: none; }
  .skeleton {
    aspect-ratio: 1;
    border-radius: var(--radius-item);
    background: var(--surface-2);
    animation: pulse 1.4s ease-in-out infinite;
  }
  @keyframes pulse { 50% { opacity: 0.5; } }

  .albums :global(a) { display: flex; flex-direction: column; gap: 4px; text-decoration: none; }
  .albums :global(.cover) {
    aspect-ratio: 1;
    margin-bottom: 6px;
    overflow: hidden;
    border-radius: var(--radius-item);
    background: var(--surface-2);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-item);
  }
  .albums :global(.cover img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.2s; }
  .albums :global(a:hover .cover img) { transform: scale(1.04); }
  .albums :global(.name) {
    font: 600 14px/1.3 var(--font-sans);
    color: var(--text-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .albums :global(.artist) {
    font: 400 12px/1.4 var(--font-sans);
    color: var(--text-subtle);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .status { font: 400 14px/1.5 var(--font-sans); color: var(--text-subtle); }

  @media (max-width: 900px) { .albums { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 500px) { .albums { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
