---
// Research statement. Edit the prose in research.md.
import Card from '../../components/Card.astro';
import { Content } from './research.md';
---

<Card id="research" kicker="~/research">
  <div class="prose"><Content /></div>
</Card>

<style>
  /* Same type as the bio on the home card. */
  .prose {
    font: 400 18px/1.6 var(--font-sans);
    color: var(--text-body);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .prose :global(a) { color: var(--text-strong); text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .prose :global(a:hover) { color: var(--accent); }
  .prose :global(ul), .prose :global(ol) { margin: 0; padding-left: 20px; }

  @media (max-width: 700px) {
    .prose { font-size: 16px; }
  }
</style>
